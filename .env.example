# LocalAsistan yapılandırması. Bu dosyayı ".env" olarak kopyalayın (git'e girmez).
# Gerçek ortam değişkenleri .env dosyasındaki değerlerin önüne geçer.

# --- LLM (sohbet için gerekli; "Araçlar" sekmesi anahtarsız da çalışır) ---
ANTHROPIC_API_KEY=
# LOCALASISTAN_MODEL=claude-opus-5-5
# Düşünme derinliği: low | medium | high | xhigh | max
# LOCALASISTAN_EFFORT=medium
# Yeterince güvenli olmayan bir yanıt reddedilirse sunucu tarafı yedek model: 1 | 0
# LOCALASISTAN_REFUSAL_FALLBACK=1
# LOCALASISTAN_MAX_TOKENS=64000
# Bir tur içinde en fazla araç-çağrı döngüsü
# LOCALASISTAN_MAX_ITERATIONS=12

# --- Onay politikası ---
# ask_destructive (varsayılan): yalnızca yıkıcı araçlar onay ister
# ask_writes: yazan her araç onay ister
# auto: hiçbir zaman sormaz (dikkat!)
# LOCALASISTAN_APPROVAL=ask_destructive

# --- Veri konumları ---
# LOCALASISTAN_HOME=~/.localasistan
# Dosya araçlarının hapsedildiği klasör (varsayılan: $LOCALASISTAN_HOME/workspace)
# LOCALASISTAN_WORKSPACE=~/Documents/LocalAsistan
# IANA saat dilimi (varsayılan: sistemden algılanır)
# LOCALASISTAN_TZ=Europe/Istanbul

# --- Web arayüzü ---
# LOCALASISTAN_HOST=127.0.0.1
# LOCALASISTAN_PORT=8765
